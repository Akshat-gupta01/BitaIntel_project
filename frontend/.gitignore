# ==============================================================================
# Frontend .gitignore - Confidential & Sensitive Data Protection
# ==============================================================================

# 1. Environment & API Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
.env.vault
.env.me
!.env.example
!.env.template

# 2. Private Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
certs/
secrets/
credentials/
*credentials*.json
service-account*.json

# 3. Dependencies & Build Artifacts
node_modules/
.next/
out/
build/
dist/

# 4. Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Uploads, Vault & Temporary Cache
public/uploads/
**/public/uploads/
uploads/
storage/
vault/
.turbo/
.cache/
.parcel-cache/
.eslintcache

# 6. Session & Local Cache Dumps
*.token
*.session
sessions/
cookies.txt
.local_storage/

# 7. OS & IDE Artifacts
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo

# 8. Testing & Coverage
coverage/
cypress/videos/
cypress/screenshots/
