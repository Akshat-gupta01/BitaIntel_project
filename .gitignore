# ------------------------------------------------------------------------------
# 4. Confidential Vendor Documents & Uploaded Files (PII, GST, PAN, Financials)
# ------------------------------------------------------------------------------
uploads/
**/uploads/
Backend/uploads/
Backend/uploads/documents/
Backend/uploads/image/
public/uploads/
**/public/uploads/
storage/
**/storage/
vault/
**/vault/
exports/
**/exports/
reports/*.pdf
reports/*.csv
reports/*.xlsx
# Preserve upload folder structure if .gitkeep is used
!uploads/.gitkeep
!**/uploads/.gitkeep
!Backend/uploads/.gitkeep
!Backend/uploads/documents/.gitkeep
!Backend/uploads/image/.gitkeep

