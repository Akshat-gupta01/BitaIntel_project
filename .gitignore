# ==============================================================================
# BITAINTEL MASTER .GITIGNORE (Confidential & Sensitive Data Protection)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Confidential Secret Configurations
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
.env.vault
.env.me
# Whitelist environment templates
!.env.example
!.env.template
!.env.sample

# ------------------------------------------------------------------------------
# 2. Private Keys, Certificates & Authentication Secrets
# ------------------------------------------------------------------------------
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
secrets/
**/secrets/
credentials/
**/credentials/
certs/
**/certs/
certificates/
**/certificates/
*.kdbx

# ------------------------------------------------------------------------------
