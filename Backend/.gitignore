# ==============================================================================
# Backend .gitignore - Confidential & Sensitive Data Protection
# ==============================================================================

# 1. Environment & Secrets
.env
.env.*
.env.local
.env.*.local
*.env
*.env.*
.env.vault
.env.me
!.env.example
!.env.template

# 2. Private Keys, Certificates & Authentication Secrets
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.keystore
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
certs/
secrets/
credentials/
*credentials*.json
service-account*.json

# 3. Confidential Vendor Documents & Uploads (PAN, GSTIN, Bank Cheques, etc.)
uploads/
uploads/**
!uploads/.gitkeep
!uploads/documents/.gitkeep
!uploads/image/.gitkeep
storage/
temp/
tmp/
vault/
exports/
reports/*.pdf
reports/*.csv
reports/*.xlsx

# 4. Database Dumps & Backups
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.rdb

# 5. Session & Auth Tokens
*.token
*.session
sessions/
cookies.txt

# 6. Dependencies & Build
node_modules/
dist/

# 7. Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 8. OS & IDE
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo

# 9. Testing & Coverage
coverage/
.nyc_output/
